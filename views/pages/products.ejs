<!DOCTYPE html>
<html lang="id">
<%- include('../partials/head', { title: title }) %>
<body class="bg-stone-50 text-stone-900 font-sans">
  <%- include('../partials/header') %>
  <main>

    <!-- ── Page Header ───────────────────────────────────────────── -->
    <section
      class="relative overflow-hidden bg-ivory text-brown"
      aria-labelledby="product-hero-heading"
    >
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10">
        <div
          class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr]
                min-h-[420px] lg:min-h-[500px]"
        >

          <!-- TEXT -->
          <div
            class="relative z-10 flex flex-col justify-center
                  py-14 lg:py-16 lg:pr-16"
          >

            <div class="flex items-center gap-3 mb-6">
              <span class="h-px w-9 bg-olive"></span>

              <span
                class="text-[11px] font-medium uppercase
                      tracking-[0.22em] text-olive"
              >
                Koleksi Kami
              </span>
            </div>

            <h1
              id="product-hero-heading"
              class="font-serif text-5xl sm:text-6xl lg:text-[64px]
                    font-normal leading-[0.98]
                    tracking-tight text-brown max-w-xl"
            >
              Produk
              <br />
              <span class="italic text-brown-light">Ecoprint.</span>
            </h1>

            <p
              class="mt-7 max-w-lg
                    text-sm lg:text-base
                    leading-7 text-taupe"
            >
              Setiap karya lahir dari perpaduan antara kekayaan alam,
              proses yang penuh perhatian, dan keindahan yang tidak pernah
              benar-benar sama.
            </p>

            <div
              class="mt-8 flex items-center gap-4
                    text-[10px] uppercase tracking-[0.2em]
                    text-taupe-light"
            >
              <span>Natural</span>
              <span class="h-px w-8 bg-olive/50"></span>
              <span>Unique</span>
              <span class="h-px w-8 bg-olive/50"></span>
              <span>Handmade</span>
            </div>

          </div>

          <!-- IMAGE -->
          <div class="relative flex items-center lg:justify-end">

            <div
              class="relative w-full lg:w-[620px]
                    h-[280px] sm:h-[340px] lg:h-[400px]
                    overflow-hidden"
            >
              <img
                src="/images/product-hero.jpg"
                alt="Koleksi produk ecoprint Usimodist"
                class="w-full h-full object-cover"
              />

              <div class="absolute inset-0 bg-brown/5"></div>

              <div
                class="absolute bottom-5 right-5
                      font-serif text-6xl lg:text-7xl
                      text-brown/10 select-none"
                aria-hidden="true"
              >
                01
              </div>
            </div>

          </div>

        </div>
      </div>

      <div
        class="absolute bottom-0 left-0 right-0
              border-t border-border/70"
      ></div>
    </section>

    <!-- ── Filter + Product Grid ──────────────────────────────────── -->
    <section class="py-10 lg:py-16 bg-ivory">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- FILTER BUTTONS -->
        <div
          class="flex flex-wrap gap-2 mb-10"
          role="group"
          aria-label="Filter teknik ecoprint"
        >

          <!-- ACTIVE -->
          <button
            type="button"
            class="filter-btn inline-flex items-center justify-center
                  px-4 py-2 min-h-[44px] min-w-[44px]
                  text-sm font-medium
                  rounded
                  border border-brown
                  bg-brown text-softwhite
                  hover:bg-brown-light
                  transition-colors duration-300
                  focus:outline-none
                  focus-visible:ring-2
                  focus-visible:ring-olive
                  focus-visible:ring-offset-2
                  focus-visible:ring-offset-ivory"
            data-technique="Semua"
            aria-pressed="true"
          >
            Semua
          </button>


          <!-- POUNDING -->
          <button
            type="button"
            class="filter-btn inline-flex items-center justify-center
                  px-4 py-2 min-h-[44px] min-w-[44px]
                  text-sm font-medium
                  rounded
                  border border-border
                  bg-softwhite text-brown
                  hover:bg-cream
                  transition-colors duration-300
                  focus:outline-none
                  focus-visible:ring-2
                  focus-visible:ring-olive
                  focus-visible:ring-offset-2
                  focus-visible:ring-offset-ivory"
            data-technique="Pounding"
            aria-pressed="false"
          >
            Pounding
          </button>


          <!-- STEAM -->
          <button
            type="button"
            class="filter-btn inline-flex items-center justify-center
                  px-4 py-2 min-h-[44px] min-w-[44px]
                  text-sm font-medium
                  rounded
                  border border-border
                  bg-softwhite text-brown
                  hover:bg-cream
                  transition-colors duration-300
                  focus:outline-none
                  focus-visible:ring-2
                  focus-visible:ring-olive
                  focus-visible:ring-offset-2
                  focus-visible:ring-offset-ivory"
            data-technique="Steam"
            aria-pressed="false"
          >
            Steam
          </button>


          <!-- IRON BLANKET -->
          <button
            type="button"
            class="filter-btn inline-flex items-center justify-center
                  px-4 py-2 min-h-[44px] min-w-[44px]
                  text-sm font-medium
                  rounded
                  border border-border
                  bg-softwhite text-brown
                  hover:bg-cream
                  transition-colors duration-300
                  focus:outline-none
                  focus-visible:ring-2
                  focus-visible:ring-olive
                  focus-visible:ring-offset-2
                  focus-visible:ring-offset-ivory"
            data-technique="Iron Blanket"
            aria-pressed="false"
          >
            Iron Blanket
          </button>

        </div>


        <!-- Pass selectedTechnique to JS for pre-select -->
        <script>
          window.__selectedTechnique = "<%= selectedTechnique %>";
        </script>


        <!-- PRODUCT GRID -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
          id="product-grid"
        >

          <% products.forEach(function(product) { %>

          <!-- PRODUCT CARD -->
          <article
            class="product-card
                  bg-softwhite
                  border border-border
                  rounded
                  overflow-hidden
                  flex flex-col
                  transition-shadow duration-300
                  hover:shadow-sm"
            data-technique="<%= product.technique %>"
          >

            <!-- IMAGE -->
            <div class="overflow-hidden">
              <img
                src="<%= product.image %>"
                alt="<%= product.name %>"
                class="w-full h-56 object-cover
                      transition-transform duration-500
                      hover:scale-[1.02]"
                loading="lazy"
              />
            </div>


            <!-- CONTENT -->
            <div class="p-5 flex flex-col gap-3 flex-1">

              <!-- TECHNIQUE -->
              <div class="flex items-center gap-2">

                <span
                  class="text-xs font-semibold uppercase
                        tracking-widest
                        text-olive
                        bg-cream
                        px-2 py-1 rounded"
                >
                  <%= product.technique %>
                </span>

              </div>


              <!-- PRODUCT NAME -->
              <h2
                class="font-serif text-lg font-semibold
                      text-brown leading-snug"
              >
                <%= product.name %>
              </h2>


              <!-- DESCRIPTION -->
              <p
                class="text-sm text-taupe
                      leading-relaxed flex-1"
              >
                <%= product.shortDescription.length > 150
                  ? product.shortDescription.substring(0, 150) + '…'
                  : product.shortDescription
                %>
              </p>


              <!-- DETAIL -->
              <a
                href="/products/<%= product.id %>"
                class="inline-flex items-center
                      text-sm font-semibold
                      text-brown
                      hover:text-brown-light
                      no-underline
                      transition-colors duration-300
                      min-h-[44px]
                      focus:outline-none
                      focus-visible:ring-2
                      focus-visible:ring-olive
                      focus-visible:ring-offset-2
                      focus-visible:ring-offset-ivory
                      rounded self-start"
              >
                Lihat Detail →
              </a>

            </div>
          </article>

          <% }) %>

        </div>

      </div>
    </section>

  </main>
  <%- include('../partials/footer') %>
</body>
</html>
