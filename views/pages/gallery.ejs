<!DOCTYPE html>
<html lang="id">
<%- include('../partials/head', { title: title }) %>
<body class="bg-stone-50 text-stone-900 font-sans">
  <%- include('../partials/header') %>
  <main>

    <!-- ── Page Header ───────────────────────────────────────────── -->
    <section
  class="relative overflow-hidden bg-ivory text-brown"
  aria-labelledby="gallery-hero-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div
      class="min-h-[380px] lg:min-h-[440px]
             flex items-center justify-center"
    >

      <!-- TEXT -->
      <div class="w-full max-w-3xl text-center">

        <!-- EYEBROW -->
        <div class="flex items-center justify-center gap-3 mb-6">

          <span class="h-px w-9 bg-olive"></span>

          <span
            class="text-[11px] font-medium uppercase
                   tracking-[0.22em] text-olive"
          >
            Visual
          </span>

          <span class="h-px w-9 bg-olive"></span>

        </div>


        <!-- HEADING -->
        <h1
          id="gallery-hero-heading"
          class="font-serif text-5xl sm:text-6xl lg:text-[64px]
                 font-normal leading-[0.98]
                 tracking-tight text-brown"
        >
          Galeri
          <br />
          <span class="italic text-brown-light">
            Usimodist.
          </span>
        </h1>


        <!-- DESCRIPTION -->
        <p
          class="mt-7 mx-auto max-w-2xl
                 text-sm lg:text-base
                 leading-7 text-taupe"
        >
          Melihat lebih dekat proses, tekstur, dan karya ecoprint
          Usimodist — dari jejak dedaunan hingga menjadi karya
          yang siap dikenakan.
        </p>


        <!-- META -->
        <div
          class="mt-8 flex items-center justify-center gap-4
                 text-[10px] uppercase
                 tracking-[0.2em] text-taupe-light"
        >
          <span>Nature</span>

          <span class="h-px w-8 bg-olive/50"></span>

          <span>Process</span>

          <span class="h-px w-8 bg-olive/50"></span>

          <span>Craft</span>
        </div>

      </div>

    </div>
  </div>


  <!-- BORDER -->
  <div
    class="absolute bottom-0 left-0 right-0
           border-t border-border/70"
  ></div>

</section>

    <!-- ── Gallery Grid ───────────────────────────────────────────── -->
    <section class="py-10 lg:py-16" aria-label="Galeri foto Usimodist">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">

        <!-- GALLERY -->
        <div
          class="
            grid
            grid-cols-1
            sm:grid-cols-2
            lg:grid-cols-[410px_205px_205px_410px]
            lg:grid-rows-[205px_205px_250px]
            gap-2
            justify-center
          "
        >

          <!-- ===================================== -->
          <!-- IMAGE 1 — LARGE LEFT -->
          <!-- 440 × 440 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-1
              lg:row-start-1
              lg:row-span-2
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-8.png"
                alt="Kain ecoprint Usimodist dengan motif daun jati"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 2 — TOP CENTER -->
          <!-- 440 × 220 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-2
              lg:row-start-1
              lg:col-span-2
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-2.jpeg"
                alt="Proses pounding kain ecoprint menggunakan palu kayu"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 3 — LARGE RIGHT -->
          <!-- 440 × 440 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-4
              lg:row-start-1
              lg:row-span-2
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-3.jpeg"
                alt="Produk jadi ecoprint Usimodist"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 4 — SMALL CENTER LEFT -->
          <!-- 220 × 220 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-2
              lg:row-start-2
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-4.jpeg"
                alt="Dedaunan alami yang digunakan untuk proses ecoprint"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 5 — SMALL CENTER RIGHT -->
          <!-- 220 × 220 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-3
              lg:row-start-2
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-5.jpeg"
                alt="Detail serat kain dan motif daun ecoprint"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 6 — BOTTOM LEFT -->
          <!-- 660 × 270 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-1
              lg:col-span-2
              lg:row-start-3
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-6.jpeg"
                alt="Kain ecoprint dengan motif daun pakis"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 7 — BOTTOM CENTER -->
          <!-- 220 × 270 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-3
              lg:row-start-3
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-7.jpeg"
                alt="Proses steam kain ecoprint"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 8 — BOTTOM RIGHT -->
          <!-- 440 × 270 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-4
              lg:row-start-3
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-1.jpeg"
                alt="Bahan alami yang digunakan dalam proses ecoprint"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>

        </div>
      </div>
    </section>

    <!-- Hover transition CSS for gallery images (pointer:fine only) -->
    <!-- Req 13.4: opacity change 0.3-0.7 OR scale 1.03-1.10 on hover for desktop -->
    <style>
      @media (pointer: fine) {
        .gallery-image:hover {
          opacity: 0.75;
          transform: scale(1.04);
        }
      }
    </style>

  </main>
  <%- include('../partials/footer') %>
</body>
</html>
