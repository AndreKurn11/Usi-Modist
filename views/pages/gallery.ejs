<!DOCTYPE html>
<html lang="id">
<%- include('../partials/head', { title: title }) %>
<body class="bg-stone-50 text-stone-900 font-sans">
  <%- include('../partials/header') %>
  <main>

    <!-- ── Page Header ───────────────────────────────────────────── -->
    <section class="bg-stone-900 text-stone-100 py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="text-xs font-semibold uppercase tracking-widest text-stone-400">Visual</span>
        <h1 class="font-serif text-4xl lg:text-5xl font-bold text-stone-100 mt-3 leading-tight">
          Galeri
        </h1>
        <p class="mt-4 text-base text-stone-300 max-w-xl leading-relaxed">
          Sebuah pandangan ke dalam dunia ecoprint Usimodist — dari dedaunan hingga karya jadi.
        </p>
      </div>
    </section>

    <!-- ── Gallery Grid ───────────────────────────────────────────── -->
    <!-- Req 13.1–13.7 -->
    <!-- min 2 columns desktop (≥768px), 1 column mobile (<768px) -->
    <!-- CSS grid masonry-like with varied heights -->
    <section class="py-10 lg:py-16" aria-label="Galeri foto Usimodist">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">

        <!-- GALLERY -->
        <div
          class="
            grid
            grid-cols-1
            sm:grid-cols-2
            lg:grid-cols-[410px_205px_205px_410px]
            lg:grid-rows-[205px_205px_250px]
            gap-2
            justify-center
          "
        >

          <!-- ===================================== -->
          <!-- IMAGE 1 — LARGE LEFT -->
          <!-- 440 × 440 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-1
              lg:row-start-1
              lg:row-span-2
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-8.png"
                alt="Kain ecoprint Usimodist dengan motif daun jati"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 2 — TOP CENTER -->
          <!-- 440 × 220 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-2
              lg:row-start-1
              lg:col-span-2
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-2.jpeg"
                alt="Proses pounding kain ecoprint menggunakan palu kayu"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 3 — LARGE RIGHT -->
          <!-- 440 × 440 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-4
              lg:row-start-1
              lg:row-span-2
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-3.jpeg"
                alt="Produk jadi ecoprint Usimodist"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 4 — SMALL CENTER LEFT -->
          <!-- 220 × 220 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-2
              lg:row-start-2
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-4.jpeg"
                alt="Dedaunan alami yang digunakan untuk proses ecoprint"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 5 — SMALL CENTER RIGHT -->
          <!-- 220 × 220 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-3
              lg:row-start-2
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-5.jpeg"
                alt="Detail serat kain dan motif daun ecoprint"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 6 — BOTTOM LEFT -->
          <!-- 660 × 270 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-1
              lg:col-span-2
              lg:row-start-3
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-6.jpeg"
                alt="Kain ecoprint dengan motif daun pakis"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 7 — BOTTOM CENTER -->
          <!-- 220 × 270 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-3
              lg:row-start-3
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-7.jpeg"
                alt="Proses steam kain ecoprint"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>


          <!-- ===================================== -->
          <!-- IMAGE 8 — BOTTOM RIGHT -->
          <!-- 440 × 270 -->
          <!-- ===================================== -->
          <figure
            class="
              group
              lg:col-start-4
              lg:row-start-3
            "
          >
            <div class="w-full h-full overflow-hidden rounded">
              <img
                src="/images/gallery/gallery-1.jpeg"
                alt="Bahan alami yang digunakan dalam proses ecoprint"
                class="
                  w-full
                  h-full
                  object-cover
                  transition-transform
                  duration-500
                  ease-out
                  group-hover:scale-105
                "
                loading="lazy"
              />
            </div>
          </figure>

        </div>
      </div>
    </section>

    <!-- Hover transition CSS for gallery images (pointer:fine only) -->
    <!-- Req 13.4: opacity change 0.3-0.7 OR scale 1.03-1.10 on hover for desktop -->
    <style>
      @media (pointer: fine) {
        .gallery-image:hover {
          opacity: 0.75;
          transform: scale(1.04);
        }
      }
    </style>

  </main>
  <%- include('../partials/footer') %>
</body>
</html>
