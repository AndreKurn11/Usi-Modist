<!DOCTYPE html>
<html lang="id">
<%- include('../partials/head', { title: title }) %>
<body class="bg-stone-50 text-stone-900 font-sans">
  <%- include('../partials/header') %>
  <main>

    <!-- ── Page Header ───────────────────────────────────────────── -->
    <section class="bg-stone-900 text-stone-100 py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="text-xs font-semibold uppercase tracking-widest text-stone-400">Hubungi Kami</span>
        <h1 class="font-serif text-4xl lg:text-5xl font-bold text-stone-100 mt-3 leading-tight">
          Kontak
        </h1>
        <p class="mt-4 text-base text-stone-300 max-w-xl leading-relaxed">
          Kami siap membantu. Hubungi kami melalui saluran di bawah ini atau kunjungi kami langsung.
        </p>
      </div>
    </section>

    <!-- ── Contact Details ───────────────────────────────────────── -->
    <!-- Req 14.1–14.7 -->
    <!-- Single column ≤767px, multi-column ≥768px -->
    <section class="py-10 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20">

          <!-- Column 1: Contact Info -->
          <div class="flex flex-col gap-8">
            <h2 class="font-serif text-2xl lg:text-3xl font-bold text-stone-900">Informasi Kontak</h2>

            <ul class="flex flex-col gap-6">

              <!-- Physical Address (Req 14.2) -->
              <li class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded bg-stone-100">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-stone-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                    <circle cx="12" cy="9" r="2.5"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1">Alamat</p>
                  <address class="not-italic text-sm text-stone-700 leading-relaxed">
                    Jl. TP. Sriwijaya <br /> 
                    Beliung, Kec. Kota Baru <br /> 
                    Kota Jambi, Jambi
                  </address>
                </div>
              </li>

              <!-- WhatsApp (Req 14.3) -->
              <li class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded bg-stone-100">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-stone-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1">WhatsApp</p>
                  <a
                    href="https://wa.me/628117443020"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-stone-700 hover:text-stone-900 underline underline-offset-4 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-700 rounded"
                    aria-label="Chat WhatsApp Usimodist (membuka tab baru)"
                  >
                    +62 811-7443-020
                  </a>
                </div>
              </li>

              <!-- Email (Req 14.4) -->
              <li class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded bg-stone-100">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-stone-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1">Email</p>
                  <span class="text-sm text-stone-700">usimodist@gmail.com</span>
                </div>
              </li>

              <!-- Instagram (Req 14.5) -->
              <li class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded bg-stone-100">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-stone-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                    <circle cx="12" cy="12" r="4"/>
                    <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1">Instagram</p>
                  <a
                    href="https://www.instagram.com/usimodist"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-stone-700 hover:text-stone-900 underline underline-offset-4 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-700 rounded"
                    aria-label="Instagram Usimodist (membuka tab baru)"
                  >
                    @usimodist
                  </a>
                </div>
              </li>

            </ul>
          </div>

          <!-- Column 2: Operating Hours + Map placeholder -->
          <div class="flex flex-col gap-8">

            <!-- Operating Hours (Req 14.6): format <day-range>, <HH:MM>–<HH:MM> <timezone> -->
            <div>
              <h2 class="font-serif text-2xl lg:text-3xl font-bold text-stone-900 mb-5">Jam Operasional</h2>
              <ul class="flex flex-col gap-3 text-sm text-stone-700">
                <li class="flex justify-between items-center py-2 border-b border-stone-200" style="border-color: rgba(120,113,108,0.20);">
                  <span class="font-medium">Senin–Jumat</span>
                  <span>09:00–17:00 WIB</span>
                </li>
                <li class="flex justify-between items-center py-2 border-b border-stone-200" style="border-color: rgba(120,113,108,0.20);">
                  <span class="font-medium">Sabtu</span>
                  <span>09:00–14:00 WIB</span>
                </li>
                <li class="flex justify-between items-center py-2">
                  <span class="font-medium">Minggu</span>
                  <span class="text-stone-500">Tutup</span>
                </li>
              </ul>
            </div>

            <!-- CTA -->
            <div class="flex flex-col gap-3 pt-4">
              <a
                href="https://wa.me/628117443020"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 min-h-[44px] text-sm font-semibold text-stone-50 bg-stone-800 hover:bg-stone-900 rounded transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-700 focus-visible:ring-offset-2"
                aria-label="Chat via WhatsApp (membuka tab baru)"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                </svg>
                Chat via WhatsApp
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

  </main>
  <%- include('../partials/footer') %>
</body>
</html>
