<!DOCTYPE html>
<html lang="id">
<%- include('../partials/head', { title: title }) %>
<body class="bg-stone-50 text-stone-900 font-sans">
  <%- include('../partials/header') %>
  <main>

    <!-- ── Page Header ───────────────────────────────────────────── -->
    <section
      class="relative overflow-hidden bg-ivory text-brown"
      aria-labelledby="contact-hero-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div
          class="min-h-[320px] lg:min-h-[360px]
                flex items-center"
        >

          <div class="max-w-3xl">

            <!-- EYEBROW -->
            <div class="flex items-center gap-3 mb-5">

              <span class="h-px w-9 bg-olive"></span>

              <span
                class="text-[11px] font-medium uppercase
                      tracking-[0.22em] text-olive"
              >
                Hubungi Kami
              </span>

            </div>


            <!-- HEADING -->
            <h1
              id="contact-hero-heading"
              class="font-serif text-5xl sm:text-6xl lg:text-[64px]
                    font-normal leading-[0.98]
                    tracking-tight text-brown"
            >
              Kontak
              <span class="italic text-brown-light">Kami.</span>
            </h1>


            <!-- DESCRIPTION -->
            <p
              class="mt-6 max-w-xl
                    text-sm lg:text-base
                    leading-7 text-taupe"
            >
              Kami siap membantu. Hubungi kami melalui saluran di bawah ini
              atau kunjungi kami langsung.
            </p>


            <!-- META -->
            <div
              class="mt-7 flex items-center gap-4
                    text-[10px] uppercase
                    tracking-[0.2em] text-taupe-light"
            >
              <span>Visit</span>

              <span class="h-px w-8 bg-olive/50"></span>

              <span>Connect</span>

              <span class="h-px w-8 bg-olive/50"></span>

              <span>Usimodist</span>
            </div>

          </div>

        </div>
      </div>


      <!-- BORDER -->
      <div
        class="absolute bottom-0 left-0 right-0
              border-t border-border/70"
      ></div>

    </section>

    <!-- ── Contact Details ───────────────────────────────────────── -->
    <section class="bg-ivory py-10 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20">

          <!-- COLUMN 1: CONTACT INFO -->
          <div class="flex flex-col gap-8">

            <h2
              class="font-serif text-2xl lg:text-3xl
                    font-normal text-brown"
            >
              Informasi Kontak
            </h2>


            <ul class="flex flex-col gap-6">

              <!-- ADDRESS -->
              <li class="flex items-start gap-4">

                <div
                  class="flex-shrink-0 w-10 h-10
                        flex items-center justify-center
                        rounded bg-cream"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-olive"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                    <circle cx="12" cy="9" r="2.5"/>
                  </svg>
                </div>

                <div>
                  <p
                    class="text-xs font-semibold uppercase
                          tracking-widest text-olive mb-1"
                  >
                    Alamat
                  </p>

                  <address
                    class="not-italic text-sm text-taupe leading-relaxed"
                  >
                    Jl. TP. Sriwijaya <br />
                    Beliung, Kec. Kota Baru <br />
                    Kota Jambi, Jambi
                  </address>
                </div>

              </li>


              <!-- WHATSAPP -->
              <li class="flex items-start gap-4">

                <div
                  class="flex-shrink-0 w-10 h-10
                        flex items-center justify-center
                        rounded bg-cream"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-olive"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                  </svg>
                </div>

                <div>
                  <p
                    class="text-xs font-semibold uppercase
                          tracking-widest text-olive mb-1"
                  >
                    WhatsApp
                  </p>

                  <a
                    href="https://wa.me/628117443020"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-brown
                          hover:text-brown-light
                          no-underline
                          transition-colors duration-300
                          focus:outline-none
                          focus-visible:ring-2
                          focus-visible:ring-olive
                          rounded"
                    aria-label="Chat WhatsApp Usimodist (membuka tab baru)"
                  >
                    +62 811-7443-020
                  </a>
                </div>

              </li>


              <!-- EMAIL -->
              <li class="flex items-start gap-4">

                <div
                  class="flex-shrink-0 w-10 h-10
                        flex items-center justify-center
                        rounded bg-cream"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-olive"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                </div>

                <div>
                  <p
                    class="text-xs font-semibold uppercase
                          tracking-widest text-olive mb-1"
                  >
                    Email
                  </p>

                  <span class="text-sm text-brown">
                    usimodist@gmail.com
                  </span>
                </div>

              </li>


              <!-- INSTAGRAM -->
              <li class="flex items-start gap-4">

                <div
                  class="flex-shrink-0 w-10 h-10
                        flex items-center justify-center
                        rounded bg-cream"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-olive"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                    <circle cx="12" cy="12" r="4"/>
                    <circle
                      cx="17.5"
                      cy="6.5"
                      r="0.5"
                      fill="currentColor"
                      stroke="none"
                    />
                  </svg>
                </div>

                <div>
                  <p
                    class="text-xs font-semibold uppercase
                          tracking-widest text-olive mb-1"
                  >
                    Instagram
                  </p>

                  <a
                    href="https://www.instagram.com/usi_modist"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-brown
                          hover:text-brown-light
                          no-underline
                          transition-colors duration-300
                          focus:outline-none
                          focus-visible:ring-2
                          focus-visible:ring-olive
                          rounded"
                    aria-label="Instagram Usimodist (membuka tab baru)"
                  >
                    @usi_modist
                  </a>
                </div>

              </li>

            </ul>

          </div>


          <!-- COLUMN 2 -->
          <div class="flex flex-col gap-8">

            <!-- OPERATING HOURS -->
            <div>

              <h2
                class="font-serif text-2xl lg:text-3xl
                      font-normal text-brown mb-5"
              >
                Jam Operasional
              </h2>

              <ul class="flex flex-col gap-3 text-sm text-taupe">

                <li
                  class="flex justify-between items-center
                        py-2 border-b border-border"
                >
                  <span class="font-medium text-brown">
                    Senin–Sabtu
                  </span>

                  <span>
                    09:00–17:00 WIB
                  </span>
                </li>

                <li
                  class="flex justify-between items-center py-2"
                >
                  <span class="font-medium text-brown">
                    Minggu
                  </span>

                  <span class="text-taupe-light">
                    Tutup
                  </span>
                </li>

              </ul>

            </div>


            <!-- CTA -->
            <div class="flex flex-col gap-3 pt-4">

              <a
                href="https://wa.me/628117443020"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center
                      gap-2 px-6 py-3 min-h-[44px]
                      text-sm font-semibold
                      text-softwhite
                      bg-brown
                      hover:bg-brown-light
                      rounded
                      transition-colors duration-300
                      focus:outline-none
                      focus-visible:ring-2
                      focus-visible:ring-olive
                      focus-visible:ring-offset-2
                      focus-visible:ring-offset-ivory"
                aria-label="Chat via WhatsApp (membuka tab baru)"
              >

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 flex-shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                </svg>

                Chat via WhatsApp

              </a>

            </div>

          </div>

        </div>
      </div>
    </section>

  </main>
  <%- include('../partials/footer') %>
</body>
</html>
