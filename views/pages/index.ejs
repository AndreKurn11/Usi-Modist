<!DOCTYPE html>
<html lang="id">
<%- include('../partials/head', { title: title }) %>
<body class="bg-ivory text-brown font-sans">
  <%- include('../partials/header') %>
  <main>

    <!-- ══════════════════════════════════════════════════════════════
    Section 1 — Hero
    ══════════════════════════════════════════════════════════════ -->
    <section
      class="relative bg-ivory overflow-hidden"
      data-reveal
      aria-labelledby="hero-heading"
    >
      <div class="max-w-[1600px] mx-auto">

        <!-- HERO WRAPPER — fixed height, tidak berubah saat zoom / reflow konten -->
        <div class="relative h-[560px] sm:h-[620px] lg:h-[720px] overflow-hidden">

          <!-- FULL-BLEED IMAGE -->
          <img
            src="/images/hero-ecoprint.jpeg"
            alt="Kain ecoprint Usimodist dengan motif daun alami"
            class="absolute inset-0 w-full h-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
          />

          <!-- GRADIENT OVERLAY — MOBILE: vertikal (atas transparan, bawah solid) -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-ivory from-20% via-ivory/80 via-55% to-transparent to-90% lg:hidden"
          ></div>

          <!-- GRADIENT OVERLAY — DESKTOP: horizontal (kiri solid, kanan transparan) -->
          <div
            class="hidden lg:block absolute inset-0 bg-gradient-to-r from-ivory from-10% via-ivory/85 via-40% to-transparent to-70%"
          ></div>

          <!-- TEXT CONTENT -->
          <div class="relative z-10 h-full flex items-end lg:items-center px-5 sm:px-8 lg:px-20 pb-10 sm:pb-12 lg:pb-0">
            <div class="max-w-lg">

              <!-- Eyebrow label -->
              <p class="text-[10px] sm:text-xs lg:text-sm font-semibold tracking-[0.2em] sm:tracking-[0.25em] text-olive/80 uppercase mb-3 sm:mb-4">
                Natural &nbsp;•&nbsp; Local &nbsp;•&nbsp; Sustainable
              </p>

              <!-- Heading -->
              <h1
                id="hero-heading"
                class="font-serif text-3xl sm:text-4xl lg:text-6xl font-normal text-brown leading-[1.15] lg:leading-[1.1]"
              >
                Keindahan Alami,<br />
                Karya Nusantara
              </h1>

              <!-- Description -->
              <p class="mt-4 sm:mt-6 max-w-md text-sm lg:text-lg text-taupe leading-relaxed">
                USI Modist menghadirkan produk ecoprint berkualitas tinggi
                yang dibuat dengan cinta untuk alam dan budaya Indonesia.
              </p>

              <!-- CTAs -->
              <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center gap-4 sm:gap-6">
                <!-- PRIMARY CTA -->
                <a
                  href="/about"
                  class="group inline-flex items-center justify-center gap-3
                        min-h-[50px] px-7 sm:px-8
                        w-full sm:w-auto
                        rounded-full
                        bg-olive text-softwhite
                        text-sm font-semibold tracking-wide
                        shadow-sm
                        animate-float-cta
                        transition-all duration-300
                        hover:bg-brown
                        hover:shadow-md
                        focus:outline-none
                        focus-visible:ring-2
                        focus-visible:ring-olive
                        focus-visible:ring-offset-2"
                >
                  <span>Cerita Kami</span>
                </a>

                <!-- SECONDARY CTA -->
                <a
                  href="/products"
                  class="group inline-flex items-center gap-2
                        min-h-[44px]
                        text-sm font-semibold tracking-wide
                        text-brown
                        transition-all duration-300
                        focus:outline-none
                        focus-visible:ring-2
                        focus-visible:ring-olive
                        focus-visible:ring-offset-2
                        no-un"
                >
                  <span
                    class="relative
                          after:absolute
                          after:left-0
                          after:-bottom-1
                          after:h-px
                          after:w-0
                          after:bg-brown
                          after:transition-all
                          after:duration-300
                          group-hover:after:w-full"
                  >
                    Lihat Koleksi
                  </span>

                  <span
                    aria-hidden="true"
                    class="transition-transform duration-300
                          group-hover:translate-x-1"
                  >
                    →
                  </span>
                </a>

              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
    Section 2 — About Preview
    ══════════════════════════════════════════════════════════════ -->
    <section
      class="bg-cream py-10 lg:py-16"
      data-reveal
      aria-labelledby="about-preview-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-stretch">

          <!-- Image — left on desktop, top on mobile -->
          <div class="w-full min-h-[240px] lg:min-h-[400px] overflow-hidden rounded">
            <img
              src="/images/about-nature.jpeg"
              alt="Pemandangan alam bahan ecoprint Usimodist"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Text block — right on desktop, below image on mobile -->
          <div class="flex flex-col justify-center gap-5">
            <div class="flex items-center gap-3">
              <span class="w-8 h-px bg-olive"></span>
              <span class="text-xs font-semibold uppercase tracking-widest text-taupe">
                Tentang Kami
              </span>
            </div>
            <h2
              id="about-preview-heading"
              class="font-serif text-3xl lg:text-4xl font-normal text-brown leading-snug"
            >
              Dari Alam, <br /> 
              Untuk Kehidupan yang <br />
              Lebih Baik
            </h2>
            <p class="text-sm lg:text-base text-taupe leading-relaxed">
              Kami percaya bahwa keindahan tidak harus datang dari bahan yang
              merusak lingkungan. Melalui teknik ecoprint, kami menciptakan
              produk yang ramah lingkungan, mendukung keberlanjutan, dan
              memberdayakan masyarakat.
            </p>
            <a
              href="/about"
              class="inline-flex items-center text-sm font-medium text-brown hover:text-olive no-underline transition-colors duration-150 min-h-[44px] focus:outline-none focus-visible:ring-2 focus-visible:ring-olive focus-visible:ring-offset-2 rounded self-start"
            >
              Selengkapnya Tentang Kami →
            </a>
          </div>

        </div>
      </div>
    </section>
    
    <!-- ══════════════════════════════════════════════════════════════
    Section 3 — Technique Cards
    ══════════════════════════════════════════════════════════════ -->
    <div class="border-t border-border"></div>
    <section
      class="bg-ivory py-10 lg:py-16"
      data-reveal
      aria-labelledby="technique-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- SECTION HEADER -->
        <div class="flex items-end justify-between mb-8 lg:mb-10">
          
          <!-- LEFT: TITLE -->
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="w-8 h-px bg-olive"></span>
              <span class="text-xs font-semibold uppercase tracking-widest text-taupe">
                Produk Kami
              </span>
            </div>

            <h2
              id="technique-heading"
              class="font-serif text-3xl sm:text-4xl lg:text-[42px] font-normal text-brown leading-[1.05]"
            >
              <span class="block">Ecoprint</span>
              <span class="block mt-2">Berdasarkan Teknik</span>
            </h2>
          </div>

          <!-- RIGHT: VIEW ALL -->
          <a
            href="/products"
            class="hidden sm:inline-flex items-center gap-3 pb-1 text-sm font-medium text-brown no-underline hover:text-olive transition-colors"
          >
            <span>Lihat Semua Produk</span>
            <span class="text-xl leading-none">→</span>
          </a>

        </div>


        <!-- PRODUCT CARDS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 lg:gap-[10px]">

          <!-- MIRROR -->
          <a
            href="/products?technique=Mirror"
            class="group relative block overflow-hidden rounded-[2px] h-[300px] lg:h-[305px] no-underline"
            data-technique="Mirror"
          >
            <img
              src="/images/technique-mirror.jpeg"
              alt="Teknik ecoprint mirror"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brown/70 via-brown/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-5 lg:p-6">
              <h3 class="font-serif text-2xl lg:text-[28px] leading-none font-normal text-softwhite mb-3">
                Mirror
              </h3>
              <div class="inline-flex items-center gap-3 text-xs lg:text-sm font-medium text-softwhite">
                <span class="font-medium">Lihat Produk</span>
                <span class="text-lg leading-none transition-transform duration-300 group-hover:translate-x-1">→</span>
              </div>
            </div>
          </a>

          <!-- BLANKET -->
          <a
            href="/products?technique=Blanket"
            class="group relative block overflow-hidden rounded-[2px] h-[300px] lg:h-[305px] no-underline"
            data-technique="Blanket"
          >
            <img
              src="/images/technique-blanket.jpeg"
              alt="Teknik ecoprint blanket"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brown/70 via-brown/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-5 lg:p-6">
              <h3 class="font-serif text-2xl lg:text-[28px] leading-none font-normal text-softwhite mb-3">
                Blanket
              </h3>
              <div class="inline-flex items-center gap-3 text-xs lg:text-sm font-medium text-softwhite">
                <span class="font-medium">Lihat Produk</span>
                <span class="text-lg leading-none transition-transform duration-300 group-hover:translate-x-1">→</span>
              </div>
            </div>
          </a>

        </div>


        <!-- MOBILE: VIEW ALL -->
        <div class="mt-6 sm:hidden">
          <a
            href="/products"
            class="inline-flex items-center gap-3 text-sm font-medium text-brown no-underline"
          >
            <span>Lihat Semua Produk</span>
            <span class="text-xl leading-none">→</span>
          </a>
        </div>

      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
    Section 4 — Mission ("Kenapa Kami Melakukan Ini?")
    ══════════════════════════════════════════════════════════════ -->
    <div class="border-t border-border"></div>
    <section
      class="bg-cream py-16 lg:py-24"
      data-reveal
      aria-labelledby="mission-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

          <!-- TEXT BLOCK -->
          <div class="flex flex-col gap-6">

            <div class="flex items-center gap-3">
              <span class="w-8 h-px bg-olive"></span>
              <span class="text-xs font-semibold uppercase tracking-[0.2em] text-olive">
                Terinspirasi dari Alam
              </span>
            </div>

            <h2
              id="mission-heading"
              class="font-serif text-3xl sm:text-4xl lg:text-[44px] leading-[1.1] font-normal text-brown"
            >
              Membawa Cerita<br />
              Hutan Harapan
            </h2>

            <div class="flex flex-col gap-4 text-sm lg:text-base text-taupe leading-relaxed max-w-xl">
              <p>
                Usi Modist lahir dari gagasan sederhana: menghadirkan fashion
                yang tidak hanya indah dan unik, tetapi juga memiliki kepedulian
                terhadap lingkungan. Terinspirasi dari kekayaan alam
                <strong class="font-semibold text-brown">Hutan Harapan Jambi</strong>,
                ecoprint menjadi bagian dari perjalanan kami untuk memperkenalkan
                keindahan alam Jambi melalui karya fashion berkelanjutan.
              </p>
              <p>
                Kekayaan flora Hutan Harapan menjadi sumber inspirasi untuk
                mengeksplorasi berbagai bentuk, warna, dan karakter daun sebagai
                motif alami pada kain. Setiap jejak daun menghasilkan karakter
                yang berbeda, sehingga setiap karya memiliki keunikan tersendiri.
              </p>
              <p>
                Bagi Usi Modist, ecoprint bukan sekadar fashion. Setiap motif
                membawa cerita tentang alam dan kekayaan hayati Jambi, sekaligus
                menjadi media untuk mengajak lebih banyak orang mengenal dan
                menghargai keberlanjutan lingkungan.
              </p>
            </div>

            <a
              href="/about"
              class="inline-flex items-center gap-2 text-sm font-medium text-brown hover:text-brown-light transition-colors duration-300 min-h-[44px] focus:outline-none focus-visible:ring-2 focus-visible:ring-olive focus-visible:ring-offset-2 focus-visible:ring-offset-cream rounded self-start w-fit pb-0.5"
            >
              Kenali Kisah Kami
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <!-- IMAGE: SPECIMEN CARD -->
          <div class="relative w-full">

            <!-- corner brackets -->
            <span class="hidden sm:block absolute -top-3 -left-3 w-8 h-8 border-t-2 border-l-2 border-brown z-10" aria-hidden="true"></span>
            <span class="hidden sm:block absolute -top-3 -right-3 w-8 h-8 border-t-2 border-r-2 border-brown z-10" aria-hidden="true"></span>
            <span class="hidden sm:block absolute -bottom-3 -left-3 w-8 h-8 border-b-2 border-l-2 border-brown z-10" aria-hidden="true"></span>
            <span class="hidden sm:block absolute -bottom-3 -right-3 w-8 h-8 border-b-2 border-r-2 border-brown z-10" aria-hidden="true"></span>

            <div id="mission-slideshow" class="relative w-full h-80 lg:h-[480px] overflow-hidden bg-cream">
              <img
                src="/images/hutan-harapan.jpg"
                alt="Hutan Harapan Jambi"
                data-slide
                class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-100"
                loading="lazy"
              />
              <img
                src="/images/hutan-harapan-2.jpg"
                alt="Kekayaan flora Hutan Harapan"
                data-slide
                class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0"
                loading="lazy"
              />
              <img
                src="/images/gallery/gallery-3.jpeg"
                alt="Karya fashion berkelanjutan Usi Modist"
                data-slide
                class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0"
                loading="lazy"
              />
              <img
                src="/images/products/kain-katun-sutra-mirror.jpeg"
                alt="Motif ecoprint dari daun Hutan Harapan"
                data-slide
                class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0"
                loading="lazy"
              />
            </div>

            <!-- caption strip, synced with active slide -->
            <div class="flex items-center justify-between mt-4 px-1">
              <p class="text-xs font-semibold uppercase tracking-widest text-brown">
                <span id="mission-slide-index">01</span>
                <span class="text-brown/50 mx-1">—</span>
                <span id="mission-slide-label">Hutan Harapan</span>
              </p>

              <div id="mission-slide-dots" class="flex items-center gap-2" role="tablist" aria-label="Pilih gambar">
                <button type="button" data-dot="0" class="w-2 h-2 rounded-full bg-brown transition-all duration-300" aria-label="Gambar 1" aria-selected="true"></button>
                <button type="button" data-dot="1" class="w-2 h-2 rounded-full bg-brown/30 transition-all duration-300" aria-label="Gambar 2" aria-selected="false"></button>
                <button type="button" data-dot="2" class="w-2 h-2 rounded-full bg-brown/30 transition-all duration-300" aria-label="Gambar 3" aria-selected="false"></button>
                <button type="button" data-dot="3" class="w-2 h-2 rounded-full bg-brown/30 transition-all duration-300" aria-label="Gambar 4" aria-selected="false"></button>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

