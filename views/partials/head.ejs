<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Usimodist — Butik ecoprint yang menghadirkan keindahan alam ke dalam setiap helai karya." />
  <title><%= typeof title !== 'undefined' ? title : 'Usimodist' %></title>

  <!-- Google Fonts: Playfair Display (serif H1/H2/H3) + Inter (sans-serif body/nav) -->
  <!-- font-display: swap handled by Google Fonts API via &display=swap -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <!-- Tailwind CSS compiled output -->
  <link rel="stylesheet" href="/css/output.css" />

  <!-- Client-side JS (deferred — no render-blocking) -->
  <script src="/js/main.js" defer></script>
</head>
