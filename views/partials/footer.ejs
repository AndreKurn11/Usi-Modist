<footer class="bg-brown-dark text-softwhite">

  <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-10">

    <!-- MAIN FOOTER -->
    <div
      class="grid grid-cols-1
             md:grid-cols-[1.5fr_0.7fr_0.7fr_1fr]
             gap-10 lg:gap-16
             py-16 lg:py-20"
    >

      <!-- BRAND -->
      <div class="flex flex-col">

        <a
          href="/"
          class="font-serif text-3xl lg:text-[34px]
                 font-semibold tracking-tight
                 text-softwhite
                 hover:text-cream
                 transition-colors duration-300
                 focus:outline-none
                 focus-visible:ring-2
                 focus-visible:ring-olive
                 focus-visible:ring-offset-2
                 focus-visible:ring-offset-brown-dark
                 rounded-sm w-fit"
        >
          Usimodist
        </a>

        <p
          class="mt-4 max-w-sm
                 text-sm lg:text-base
                 leading-relaxed
                 text-taupe-light"
        >
          Keindahan alam, diabadikan dalam setiap helai
          karya ecoprint.
        </p>

        <!-- SMALL ACCENT -->
        <span
          class="mt-8 w-12 h-px bg-olive"
          aria-hidden="true"
        ></span>

        <p
          class="mt-6 text-xs lg:text-sm
                 text-taupe-light"
        >
          &copy; <%= new Date().getFullYear() %>
          Usimodist. Hak cipta dilindungi.
        </p>

      </div>


      <!-- NAVIGATION -->
      <nav aria-label="Navigasi footer">

        <h3
          class="text-xs font-semibold
                 uppercase tracking-[0.18em]
                 text-olive mb-5"
        >
          Navigasi
        </h3>

        <ul class="grid grid-cols-2 gap-x-8 gap-y-1">

          <li>
            <a
              href="/"
              class="inline-flex items-center
                    min-h-[40px]
                    text-sm lg:text-base
                    text-taupe-light
                    hover:text-softwhite
                    transition-colors duration-300"
            >
              Beranda
            </a>
          </li>

          <li>
            <a
              href="/about"
              class="inline-flex items-center
                    min-h-[40px]
                    text-sm lg:text-base
                    text-taupe-light
                    hover:text-softwhite
                    transition-colors duration-300"
            >
              Tentang
            </a>
          </li>

          <li>
            <a
              href="/products"
              class="inline-flex items-center
                    min-h-[40px]
                    text-sm lg:text-base
                    text-taupe-light
                    hover:text-softwhite
                    transition-colors duration-300"
            >
              Produk
            </a>
          </li>

          <li>
            <a
              href="/gallery"
              class="inline-flex items-center
                    min-h-[40px]
                    text-sm lg:text-base
                    text-taupe-light
                    hover:text-softwhite
                    transition-colors duration-300"
            >
              Galeri
            </a>
          </li>

          <li>
            <a
              href="/contact"
              class="inline-flex items-center
                    min-h-[40px]
                    text-sm lg:text-base
                    text-taupe-light
                    hover:text-softwhite
                    transition-colors duration-300"
            >
              Kontak
            </a>
          </li>

        </ul>

      </nav>


      <!-- SECONDARY -->
      <nav aria-label="Informasi">

        <h3
          class="text-xs font-semibold
                 uppercase tracking-[0.18em]
                 text-olive mb-5"
        >
