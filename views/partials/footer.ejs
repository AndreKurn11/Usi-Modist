                     text-softwhite
                     hover:text-olive
                     transition-colors duration-300
                     focus:outline-none
                     focus-visible:ring-2
                     focus-visible:ring-olive
                     focus-visible:ring-offset-2
                     focus-visible:ring-offset-brown-dark
                     rounded"
              aria-label="WhatsApp Usimodist"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
              </svg>
            </a>
          </li>

        </ul>

      </div>

    </div>


    <!-- BOTTOM DIVIDER -->
    <div
      class="border-t border-olive/40"
    ></div>


    <!-- OPTIONAL BOTTOM LINE -->
    <div
      class="py-5 flex flex-col sm:flex-row
             sm:items-center
             sm:justify-between
             gap-2"
    >

      <span class="text-[11px] uppercase tracking-[0.16em] text-taupe">
        Natural · Local · Sustainable
      </span>

      <span class="text-[11px] text-taupe">
        Ecoprint Usimodist
      </span>

