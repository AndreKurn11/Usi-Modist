              Proses Ecoprint
            </a>
          </li>

          <li>
            <a
              href="/products"
              class="inline-flex items-center
                     min-h-[40px]
                     text-sm lg:text-base
                     text-taupe-light
                     hover:text-softwhite
                     transition-colors duration-300"
            >
              Teknik
            </a>
          </li>

          <li>
            <a
              href="/contact"
              class="inline-flex items-center
                     min-h-[40px]
                     text-sm lg:text-base
                     text-taupe-light
                     hover:text-softwhite
                     transition-colors duration-300"
            >
              Kontak
            </a>
          </li>

        </ul>

      </nav>


